# 編集時点で改行と文字コードの揺れを防ぐ(.gitattributes は取り込み時の保険)。
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# cmd.exe が読む。改行は CRLF で固定する
[*.bat]
end_of_line = crlf

[*.{yml,yaml,json}]
indent_size = 2

# 画面の資産(pctool/padcue/web/)は 2 スペース
[*.{js,css,html}]
indent_size = 2
