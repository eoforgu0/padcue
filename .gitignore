# ESP-IDF
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
# WiFi の接続情報(この PC 固有。リポジトリには入れない)
firmware/sdkconfig.defaults.local
firmware/managed_components/

# Python
__pycache__/
*.pyc
.pytest_cache/
# ruff は .ruff_cache/.gitignore(中身は *)を自分で書くので黙って無視される。
# それに頼らずここにも書く — 書き出す前の一瞬や、そのファイルを消した状態で
# 追跡候補に現れるうえ、.pytest_cache だけ明示されているのは揃っていない
.ruff_cache/

# プロジェクト作業物(手順のコンパイル結果と接続先設定は環境依存)
build/
padcue.json
padcue.json.bak

# 実行時生成物
.hosttest/
logs.jsonl
runstate.json
# 置き換え用の一時ファイル(coupler._save_runstate)。正常終了すれば残らないが、
# 書き込み中に落ちたときに残る — そのクラッシュこそが一時ファイルを使う理由
runstate.json.tmp
gui_server.json
uicheck/
runbook_walk/
# 検査道具の出力先(CI と同じ名前で手元で流したときの生成物)
uicheck-out/
runbook-walk-out/
# パッケージのビルド成果物
dist/
*.egg-info/
.venv/

# 画面の写しの出力先(pctool/tools/shoot.py <出力フォルダ>)。
# 文書に載せるものだけ docs/images/ に置いて追跡する
shots/

# 利用者の個人データ(連結実行の編成)。ソフトウェア本体ではない
sets/

# 利用者の個人データ(作った手順・部品・並び順)。ソフトウェア本体ではない
# どの階層をプロジェクトフォルダにしても効くよう、位置を固定しない
procedures/
parts/
order.json

# 手元の作業記録(引き継ぎメモ・内部の検討記録)。公開物ではない
/docs/notes/
