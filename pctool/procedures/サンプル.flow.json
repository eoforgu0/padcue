{
  "schema": 1,
  "name": "サンプル",
  "pre": "ホーム画面を開いた状態",
  "body": [
    {
      "type": "label",
      "text": "開始"
    },
    {
      "type": "press",
      "buttons": [
        "A"
      ],
      "frames": 5
    },
    {
      "type": "wait",
      "frames": 60
    },
    {
      "type": "loop",
      "count": 3,
      "body": [
        {
          "type": "part",
          "ref": "サンプル部品"
        },
        {
          "type": "wait",
          "frames": 30
        }
      ]
    },
    {
      "type": "label",
      "text": "終了"
    },
    {
      "type": "wait",
      "frames": 60
    }
  ]
}